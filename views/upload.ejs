<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <div>
        <% if (locals.user) {%>
            <p>Welcome, <%= user.name %></p>
            <a href="/logout">
                <button>Logout</button>
            </a>
        <% } else { %>
            <p>Please log in</p>
        <% } %>
    </div>

    <form action="/upload" method="POST" enctype="multipart/form-data">
        <input type="file" name="yourfile" id="yourfile">
        <button type="submit">Upload File</button>
    </form>

    <h2>Your Uploaded Files</h2>
    <% if (files && files.length > 0) { %>
        <ul>
            <% files.forEach(file => { %>
                <li>
                    <strong><%= file.filename %></strong>
                    — <a href="/<%= file.path %>" target="_blank" download>Download</a>
                    
                    <!-- Preview if it's an image -->
                    <% if (file.filename.match(/\.(jpg|jpeg|png|gif|webp)$/i)) { %>
                        <br>
                        <img src="/<%= file.path %>" alt="<%= file.filename %>" style="max-width: 70px; height: auto; margin-top: 5px;">
                    <% } %>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No files uploaded yet.</p>
    <% } %>

    <div>
        <a href="/">Home</a>
        <a href="/register">Register</a>
    </div>
</body>
</html>