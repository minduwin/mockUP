<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <div>
        <% if (locals.user) {%>
            <p>Welcome, <%= user.name %></p>
            <a href="/logout">
                <button>Logout</button>
            </a>
        <% } else { %>
            <p>Please log in</p>
        <% } %>
    </div>

    <div>
        <a href="/register">Register</a>
        <a href="/login">Login</a>
        <% if (locals.user) { %>
            <a href="/upload">Upload</a>
        <% } %>
    </div>
</body>
</html>